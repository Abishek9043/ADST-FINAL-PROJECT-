# EduPulse AI - Environment Configuration Template
# Duplicate this file as '.env' for local secrets and deployment overrides.

# Flask Backend Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=127.0.0.1

# SQLite Database
DATABASE_URL=sqlite:///backend/edupulse.db

# Machine Learning Artifacts
MODEL_PATH=models/edupulse_best_model.joblib
METRICS_PATH=models/model_metrics.json

# Frontend Configuration
VITE_API_URL=http://127.0.0.1:5000/api
